+            break;
+        case kCTFontViewsFontType:
+            themeFont = kThemeViewsFont;
+            break;
+        case kCTFontLabelFontType:
+            themeFont = kThemeLabelFont;
+            break;
+        default:
+            break;
+    }
+
+    Str255 fontName;
+    FMFontSize fontSize = 0;
+    Style fontStyle = 0;
